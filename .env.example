# Copy to .env and fill in. Never commit .env.

# Hugging Face token — enables POST /explain (Flan-T5-Base via HF Inference API)
HF_TOKEN=

# Maximum accepted upload size for /predict, in MB
MAX_UPLOAD_MB=10

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Grafana admin credentials (docker-compose refuses to start without a password)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
