# Copy to .env and fill in. Never commit .env.

# Hugging Face token for POST /explain. Needs the "Make calls to Inference Providers" permission.
HF_TOKEN=

# Chat model used for /explain (must be served by an HF inference provider)
EXPLAIN_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Maximum accepted upload size for /predict, in MB
MAX_UPLOAD_MB=10

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Grafana admin credentials (docker-compose refuses to start without a password)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
